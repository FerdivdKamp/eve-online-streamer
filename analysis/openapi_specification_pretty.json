        ],
        "summary": "Get Info",
        "description": "Get photo information for a specific photo,\nReturns the photo information for a specific photo based on its unique identifier.",
        "operationId": "get_info_api_photo_info_get",
        "parameters": [
          {
            "name": "photo_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Unique identifier for photo to extract photo",
              "title": "Photo Id"
            },
            "description": "Unique identifier for photo to extract photo"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInfoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/market": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Get Market Data",
        "description": "Get Online market data with price drop opportunities\n\nReturns market data for items where the price has dropped below a specified threshold\ncompared to the average price over the specified timeframe.",
        "operationId": "get_market_data_api_market_get",
        "parameters": [
          {
            "name": "region_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Online region ID",
              "title": "Region Id"
            },
            "description": "Online region ID"
          },
          {
            "name": "item_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Item type ID",
              "title": "Item Id"
            },
            "description": "Item type ID"
          },
          {
            "name": "threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": 1.0,
              "description": "Price drop threshold in percentage",
              "default": 30.0,
              "title": "Threshold"
            },
            "description": "Price drop threshold in percentage"
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "'daily', 'weekly', or 'monthly'",
              "default": "weekly",
              "title": "Timeframe"
            },
            "description": "'daily', 'weekly', or 'monthly'"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page",
              "default": 20,
              "title": "Per Page"
            },
            "description": "Items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
